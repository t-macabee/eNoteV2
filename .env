# Copy to .env in the repository root (eNoteV2/.env) before: docker compose up --build

# SQL Server (Docker) - only used when running via `docker compose up --build`.
# Not read at all for the LocalDB connection string below.
MSSQL_SA_PASSWORD=Passw0rd!23

# Local dev via the local SQL Server (MSSQLSERVER) instance, Windows-
# authenticated - no password. This is what `dotnet ef` and the API use
# when you run everything outside Docker. NOT used by the api/worker
# containers - they get Server=sqlserver from docker-compose.yml instead.
ConnectionStrings__DefaultConnection=Server=localhost;Database=150057;Trusted_Connection=True;TrustServerCertificate=True;

# JWT signing key (min 32 characters)
JWT__KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# SMTP (required for password-reset and notification emails)
SMTP_HOST=smtp.example.com
SMTP_FROM=noreply@example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Public client URL that receives the email and token query parameters.
SMTP_PASSWORD_RESET_URL=https://app.example.com/reset-password

# Optional host port overrides
# API_PORT=5059
# SQLSERVER_PORT=1433
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Local dev (non-Docker) RabbitMQ - the API/Worker read these directly via
# .NET's double-underscore env var binding (RabbitMQ__Host -> RabbitMQ:Host).
# Requires a RabbitMQ broker actually reachable at localhost:5672.
RABBITMQ__HOST=localhost
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=guest

# Stripe (instrument rental payments) - required by docker-compose.yml for
# both the api and worker containers (Stripe__SecretKey / Stripe__WebhookSecret
# are marked ${VAR:?...} there, so `docker compose up` fails without these).
STRIPE_SECRET_KEY=sk_test_...            # Stripe.net server key - required, get from dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...       # optional, used if the client fetches config from the API
STRIPE_WEBHOOK_SECRET=whsec_...          # required - use the value `stripe listen` prints for local testing
STRIPE_CURRENCY=eur                      # optional, default "eur"
STRIPE_STATEMENT_DESCRIPTOR=ENOTE Rental # optional, 5-22 chars shown on card statement

# Local dev (non-Docker) Stripe - the API reads these directly via .NET's
# double-underscore env var binding (Stripe__SecretKey -> Stripe:SecretKey),
# same reason RabbitMQ__* exists above. FAKE placeholders, not real Stripe
# keys - just enough to satisfy ConfigurationExtensions.ValidateRequiredSettings
# so the app boots locally. Payment calls that actually hit Stripe will fail
# with these; swap in real sk_test_.../whsec_... values from
# dashboard.stripe.com/test/apikeys and `stripe listen` when you need working
# payments, not just a boot.
Stripe__SecretKey=sk_test_fake_local_dev_placeholder_not_a_real_key
Stripe__WebhookSecret=whsec_fake_local_dev_placeholder_not_a_real_secret

# Local dev (non-Docker) SMTP - same double-underscore reason as Stripe/RabbitMQ
# above. FAKE placeholders, not a real mailbox - just enough to satisfy
# SmtpEmailService's constructor so the app boots locally. Password-reset
# emails will fail to actually send with these; swap in real SMTP creds
# when you need working email delivery, not just a boot.
Smtp__Host=smtp.example.com
Smtp__From=noreply@example.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=your-smtp-username
Smtp__Password=your-smtp-password
Smtp__PasswordResetUrl=https://app.example.com/reset-password
