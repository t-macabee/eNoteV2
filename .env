# Every configuration value lives here once, under its .NET name (Section__Key).
# `dotnet run` reads this file directly via DotEnvConfiguration.Load().
# `docker compose` passes it to the api and worker containers with env_file and
# overrides only the Docker hostnames (see docker-compose.yml).

# SQL Server (Docker) - only used when running via `docker compose up --build`.
MSSQL_SA_PASSWORD=Passw0rd!23

# Local dev via the local SQL Server (MSSQLSERVER) instance, Windows-
# authenticated - no password. This is what `dotnet ef` and the API use
# when you run everything outside Docker. NOT used by the api/worker
# containers - docker-compose.yml overrides it with Server=sqlserver.
ConnectionStrings__DefaultConnection=Server=localhost;Database=150057;Trusted_Connection=True;TrustServerCertificate=True;

# JWT signing key (min 32 characters) and token settings.
Jwt__Key=enote-local-dev-603dcb674c843771b3720d1bf523026b22a18fc93d31caaf
Jwt__Issuer=ENote.Api
Jwt__Audience=ENote.Client
Jwt__ExpirationMinutes=120

# RabbitMQ - local dev points at localhost:5672; the Docker containers get
# RabbitMQ__Host=rabbitmq from docker-compose.yml.
RabbitMQ__Host=localhost
RabbitMQ__VirtualHost=/
RabbitMQ__User=guest
RabbitMQ__Password=guest

# SMTP - local dev points at Mailhog on localhost:1025; the Docker containers
# get Smtp__Host=mailhog from docker-compose.yml.
# Start Mailhog with: docker compose up -d mailhog
Smtp__Host=localhost
Smtp__Port=1025
Smtp__EnableSsl=false
Smtp__Username=
Smtp__Password=
Smtp__From=noreply@example.com
Smtp__PasswordResetUrl=enote://reset-password

# Stripe (instrument rental payments) - test-mode keys. Required by the API.
Stripe__SecretKey=sk_test_51UDoFIJ7yQsHyPd6ilGyG7ucHtuzDO2WI4ikj8eUNWn7kbBqE8Qql2OxT2NhNhLYKjRncZ1K2wGi6s6VFu79agU700jY91f4Jb
Stripe__WebhookSecret=whsec_09b59b833e3997683d0227317b6107055eca54bab497f874125c1d5506b99450
Stripe__Currency=bam
Stripe__StatementDescriptor=ENOTE Rental

# The API does not read this key; pass it to the mobile app with
# --dart-define=STRIPE_PUBLISHABLE_KEY=...
STRIPE_PUBLISHABLE_KEY=pk_test_51UDoFIJ7yQsHyPd60SWjfsBOSmqJiNAWN9aLW4D90rTrUQHMnBrQDYtV5B0OYc9U5R1K9Ipf9zp0Fiee5q78zHd600jKIW7BcH

# Uploaded-file storage root.
Storage__Root=wwwroot

# CORS origins for the local clients.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5059
Cors__AllowedOrigins__2=https://localhost:7239

# Seeded review accounts (RS2 credentials table). Applied to every seeded
# account: desktop, mobile, admin, instructor, student, storeemployee.
Seed__DefaultPassword=test

# Optional host port overrides
# API_PORT=5059
# SQLSERVER_PORT=1433
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
