# Copy to .env and adjust for your machine.

# Option A — Docker SQL Server (run: docker compose up -d)
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=enote;User Id=sa;Password=YourStrong!Passw0rd;MultipleActiveResultSets=true;TrustServerCertificate=True

# Option B — Local SQL Server / Windows auth (default instance)
ConnectionStrings__DefaultConnection=Server=localhost;Database=IB150057;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Option C — LocalDB
# ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=enote;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

Jwt__Key=your-super-secret-jwt-key-change-this-in-production-min-32-chars
Jwt__Issuer=ENote.Api
Jwt__Audience=ENote.Client
Jwt__ExpirationDays=7
