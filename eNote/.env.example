# Copy to .env and adjust for your machine.

# Option A — Local SQL Server / Windows auth (default instance)
ConnectionStrings__DefaultConnection=Server=localhost;Database=150057;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Option B — LocalDB
# ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=150057;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

Jwt__Key=your-super-secret-jwt-key-change-this-in-production-min-32-chars
Jwt__Issuer=ENote.Api
Jwt__Audience=ENote.Client
Jwt__ExpirationDays=7

# Required in production; optional in Development (see appsettings.Development.json)
Cors__AllowedOrigins__0=http://localhost:3000
