root = true

# Human-readable style guide (spacing, grouping, var): CODING_STYLE.md

[*.cs]

indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8
max_line_length = 180

# Allman bracing
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_name_and_open_parenthesis = false

csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true
csharp_wrapping_arguments = do_not_wrap
csharp_wrapping_method_parameters = do_not_wrap

# var — see CODING_STYLE.md §2
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_predefined_type_for_locals_members_parameters = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion