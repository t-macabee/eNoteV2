<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn workspaces -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.12.0" />
    
    <!-- Locator -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    
    <!-- Hashing -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    
    <!-- 
      MSBuild packages – ExcludeAssets="runtime" is REQUIRED by Microsoft.Build.Locator.
      This prevents the MSBuild DLLs from being copied to your output folder.
    -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.13.26" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.13.26" ExcludeAssets="runtime" />
    
    <!-- 
      System.Security.Cryptography.Xml – version 10.0.7 fixes BOTH vulnerabilities
      (GHSA-37gx-xxp4-5rgx and GHSA-w3x6-4m5h-cxqf).
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.7" />
  </ItemGroup>

</Project>