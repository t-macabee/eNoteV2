# Copy to .env in the repository root (eNoteV2/.env) before: docker compose up --build

# SQL Server (Docker) — must meet SQL Server password policy
MSSQL_SA_PASSWORD=Your_strong_Password123!

# JWT signing key (min 32 characters)
JWT__KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Optional host port overrides
# API_PORT=5059
# SQLSERVER_PORT=1433
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
